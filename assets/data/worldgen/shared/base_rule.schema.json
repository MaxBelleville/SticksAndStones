{
	"type": "object",
	"title": "Base Rules",
	"description": "Used to define baseplate rules for structure generation",
	"properties": {
		"id": {
			"type": "string",
			"format": "namespaced"
		},
		"min_weight": {
			"type": "number"
		},
		"is_feature": {
			"type": "boolean"
		},
		"scope": {
			"enum": ["region", "biome", "subbiome"]
		},
		"rule_type": {
			"type": "string"
		},
		"child_id": { "asset_ref": "worldshared:base_rule" }
	},
	"required": ["id", "min_weight", "is_feature", "scope", "rule_type"]
}
